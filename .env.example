# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). .env.local is gitignored — never commit
# real keys.
#
# If these are left unset, the site and admin panel still work: every fetch
# falls back to the static data in /data/*.ts, and the admin dashboard shows
# a setup notice instead of the CRUD forms.

# Public — safe to expose to the browser. Used for read-only queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix this with NEXT_PUBLIC_. Bypasses Row Level
# Security; only used inside Server Actions (app/admin/actions.ts) behind
# assertLocalAdmin().
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional second factor for /admin, on top of the NODE_ENV=development gate.
# Useful when testing a production build locally (`next build && next start`
# still has NODE_ENV=production, so this is the only way in at that point).
# Leave unset to rely on NODE_ENV alone. Never set this in a deployed
# production environment — production is blocked outright regardless.
ADMIN_SECRET=

# Contact Box (app/api/contact/route.ts). Get a free key at resend.com — no
# credit card needed for low volume. Without it, submissions are still saved
# to the Supabase `messages` table (once Supabase is configured above), just
# not emailed.
RESEND_API_KEY=

# Where Contact Box submissions get emailed. Defaults to
# satish.21.buv@gmail.com in code if left unset.
CONTACT_RECEIVER_EMAIL=satish.21.buv@gmail.com

# Must be onboarding@resend.dev (Resend's shared sandbox sender) until you
# verify your own domain in Resend — verified custom domains can send from
# any address on that domain instead.
CONTACT_SENDER_EMAIL=Cricket Portfolio <onboarding@resend.dev>
